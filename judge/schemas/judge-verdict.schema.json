{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judge verdict for one requirement or question",
  "type": "object",
  "required": ["question_id", "subject", "label", "verdict", "tier", "evidence", "decided_by"],
  "properties": {
    "question_id": {"type": "string"},
    "subject": {"type": "string", "description": "Requirement id, block id, card id or claim id being judged"},
    "label": {"type": "string", "description": "Must be one of the question's labels"},
    "verdict": {"enum": ["pass", "fail", "inconclusive", "not_checked"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Agreement-based by default; JEV probability if the plug-in is released"},
    "agreement": {"type": "object", "properties": {"runs": {"type": "integer"}, "same_label": {"type": "boolean"}}},
    "tier": {"enum": [0, 1, 2, 3]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "description": "path#Lx-Ly, evidence.jsonl line, render path"}},
    "severity": {"enum": ["blocker", "major", "minor", "none"]},
    "decided_by": {"type": "object", "required": ["vendor", "model"], "properties": {"vendor": {"type": "string"}, "model": {"type": "string"}, "cli_version": {"type": "string"}}},
    "escalated_from": {"type": ["integer", "null"]},
    "exception_signed_by_mark": {"type": ["string", "null"], "description": "Date if the owner accepted a failed requirement as an exception"}
  }
}
