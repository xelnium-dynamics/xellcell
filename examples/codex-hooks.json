{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_start.py\" --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_hooks.py\" prompt --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_hooks.py\" pre --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_hooks.py\" post --agent codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_hooks.py\" end --agent codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
