{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_start.py\" --agent claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_hooks.py\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|Read|Grep|Glob|WebSearch|WebFetch|mcp__.*(search|fetch|scrape|crawl).*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_hooks.py\" pre",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Read|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_hooks.py\" post",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/xellcell/tools/brain_hooks.py\" end",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
